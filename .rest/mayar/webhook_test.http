# Secrets come from .rest/mayar/.env (gitignored): MAYAR_WEBHOOK_TOKEN.
@hookToken = {{$dotenv MAYAR_WEBHOOK_TOKEN}}

### Post a fake payment.received to the dev tunnel
POST https://jordans-mac-mini.tail7d99a4.ts.net/api/v1/payments/mayar/webhook/
X-Callback-Token: {{hookToken}}
Content-Type: application/json

{
  "event": "testing",
  "data": {
    "id": "123456789",
    "transactionId": "123456789",
    "status": "SUCCESS",
    "productId": "11223344",
    "productType": "payment_request",
    "amount": 100000
  }
}
