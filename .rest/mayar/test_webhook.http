# Secrets come from .rest/mayar/.env (gitignored): MAYAR_WEBHOOK_TOKEN.
@base = http://127.0.0.1:8000/api/v1
@hookToken = {{$dotenv MAYAR_WEBHOOK_TOKEN}}

### payment.received, real Mayar shape. productId must equal Subscription.payment_ref;
### the view then re-fetches GET /payments/{productId} and only activates if "paid".
POST {{base}}/payments/mayar/webhook/
Content-Type: application/json
X-Callback-Token: {{hookToken}}

{
    "event": "payment.received",
    "data": {
        "id": "eef37d27-6e9e-4a42-9ad8-9ea3129378a4",
        "transactionId": "eef37d27-6e9e-4a42-9ad8-9ea3129378a4",
        "status": "SUCCESS",
        "transactionStatus": "paid",
        "customerEmail": "test@example.com",
        "amount": 49000,
        "productId": "REPLACE_WITH_SUBSCRIPTION_PAYMENT_REF",
        "productType": "payment_request",
        "paymentMethod": "QRIS"
    }
}

### Negative: missing X-Callback-Token → 401
POST {{base}}/payments/mayar/webhook/
Content-Type: application/json

{"event":"payment.received","data":{"id":"eef37d27-6e9e-4a42-9ad8-9ea3129378a4"}}

### Negative: unknown ids → 404
POST {{base}}/payments/mayar/webhook/
Content-Type: application/json
X-Callback-Token: {{hookToken}}

{"event":"payment.received","data":{"id":"does-not-exist"}}
