# Secrets come from .rest/mayar/.env (gitignored): MAYAR_API_KEY, MAYAR_WEBHOOK_TOKEN.
# Sandbox: https://api.mayar.io/hl/v2 · Prod: https://api.mayar.id/hl/v2
@mayarBase = https://api.mayar.io/hl/v2
@mayarToken = {{$dotenv MAYAR_API_KEY}}

@paymentId = REPLACE_WITH_DATA_ID_FROM_CREATE_RESPONSE

### Get payment request status (unpaid | paid | closed)
GET {{mayarBase}}/payments/{{paymentId}}
Authorization: Bearer {{mayarToken}}

### Sandbox only: simulate payment (body undocumented; adjust if rejected)
POST {{mayarBase}}/payments/simulate
Authorization: Bearer {{mayarToken}}
Content-Type: application/json

{"id": "{{paymentId}}"}
