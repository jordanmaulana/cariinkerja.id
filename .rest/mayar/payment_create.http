# Secrets come from .rest/mayar/.env (gitignored): MAYAR_API_KEY, MAYAR_WEBHOOK_TOKEN.
# Sandbox: https://api.mayar.io/hl/v2 · Prod: https://api.mayar.id/hl/v2
@mayarBase = https://api.mayar.io/hl/v2
@mayarToken = {{$dotenv MAYAR_API_KEY}}

### Create payment request (what checkout calls)
POST {{mayarBase}}/payments/create
Authorization: Bearer {{mayarToken}}
Content-Type: application/json

{
    "name": "Test User",
    "email": "test@example.com",
    "amount": 49000,
    "redirectUrl": "http://localhost:5173/plans?payment=success",
    "description": "Basic subscription (1 month)"
}
